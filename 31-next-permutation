class Solution {
public:
    void nextPermutation(vector<int>& nums) {
        int n = nums.size();
        int i = n - 2;
        while (i >= 0 && nums[i] >= nums[i + 1]) {
            i--;
        }
        if (i >= 0) {
            int l = i + 1, r = n - 1;
            int a = -1;

            while (l <= r) {
                int mid = l + (r - l) / 2;

                if (nums[mid] > nums[i]) {
                    a = mid;
                    l = mid + 1;  
                } else {
                    r = mid - 1;
                }
            }
            swap(nums[i], nums[a]);
        }
        reverse(nums.begin() + i + 1, nums.end());
    }
};
